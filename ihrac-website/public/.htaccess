<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Serve index.html directly if requested
  RewriteRule ^index\.html$ - [L]
  
  # If the requested file or directory does not exist, route to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Custom 404 fallback to React entry point
ErrorDocument 404 /index.html